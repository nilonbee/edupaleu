generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  productId     String     @id
  name          String
  price         Float
  rating        Float?
  stockQuantity Int
  purchases     Purchase[]
  sales         Sale[]
}

model Sale {
  saleId      String   @id
  productId   String
  timestamp   DateTime
  quantity    Int
  unitPrice   Float
  totalAmount Float
  product     Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)
}

model Purchase {
  purchaseId String   @id
  productId  String
  timestamp  DateTime
  quantity   Int
  unitCost   Float
  totalCost  Float
  product    Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)
}

model Expense {
  expenseId String   @id
  category  String
  amount    Float
  timestamp DateTime
}

model SalesSummary {
  salesSummaryId   String   @id
  totalValue       Float
  changePercentage Float?
  date             DateTime
}

model PurchaseSummary {
  purchaseSummaryId String   @id
  totalPurchased    Float
  changePercentage  Float?
  date              DateTime
}

model ExpenseSummary {
  expenseSummaryId  String              @id
  totalExpenses     Float
  date              DateTime
  expenseByCategory ExpenseByCategory[]
}

model ExpenseByCategory {
  expenseByCategoryId String         @id
  expenseSummaryId    String
  category            String
  amount              BigInt
  date                DateTime
  expenseSummary      ExpenseSummary @relation(fields: [expenseSummaryId], references: [expenseSummaryId], onDelete: Cascade)
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id                          Int                        @id @default(autoincrement())
  email                       String                     @unique @db.VarChar(255)
  passwordHash                String                     @db.VarChar(255)
  firstName                   String                     @db.VarChar(100)
  lastName                    String                     @db.VarChar(100)
  roleId                      Int
  phone                       String?                    @db.VarChar(20)
  isActive                    Boolean                    @default(true)
  lastLogin                   DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @default(now())
  displayPicture              String?                    @db.VarChar(500)
  verificationToken           String?                    @db.VarChar(255)
  isVerified                  Boolean                    @default(false)
  verified                    DateTime?
  passwordToken               String?                    @db.VarChar(255)
  passwordTokenExpirationDate DateTime?
  inviteToken                 String?                    @db.VarChar(255)
  inviteTokenExpirationDate   DateTime?
  mustChangePassword          Boolean                    @default(false)
  applicationsAssignedAsAgent Application[]              @relation("ApplicationAssignedAgent")
  applicationsAssignedTo      Application[]              @relation("ApplicationAssignedTo")
  communications              ApplicationCommunication[]
  documentsUploaded           ApplicationDocument[]      @relation("DocumentUploadedBy")
  authTokens                  AuthToken[]
  enquiriesAssigned           Enquiry[]                  @relation("EnquiryAssignedTo")
  refreshTokens               RefreshToken[]
  studentsCreated             Student[]                  @relation("StudentCreatedBy")
  role                        Role                       @relation(fields: [roleId], references: [id])

  @@index([inviteToken])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @db.VarChar(500)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model AuthToken {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String   @db.VarChar(255)
  ip           String   @db.VarChar(100)
  userAgent    String   @db.VarChar(500)
  isValid      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model Country {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(100)
  code         String        @unique @db.VarChar(3)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  applications Application[]
  enquiries    Enquiry[]
  universities University[]
}

model University {
  id                  Int           @id @default(autoincrement())
  name                String        @db.VarChar(255)
  countryId           Int
  website             String?       @db.VarChar(255)
  email               String?       @db.VarChar(255)
  phone               String?       @db.VarChar(20)
  ranking             Int?
  tuitionFeeRange     String?       @db.VarChar(100)
  intakeMonths        Json?
  applicationDeadline Int?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now())
  applications        Application[]
  country             Country       @relation(fields: [countryId], references: [id])

  @@index([countryId])
}

model Student {
  id                      Int              @id @default(autoincrement())
  firstName               String           @db.VarChar(100)
  lastName                String?          @db.VarChar(100)
  dateOfBirth             DateTime
  gender                  Gender
  email                   String           @unique @db.VarChar(255)
  phone                   String?          @db.VarChar(20)
  secondPhone             String?          @db.VarChar(20)
  nationality             String?          @db.VarChar(100)
  passportNumber          String?          @unique @db.VarChar(50)
  displayPicture          String?
  passportExpiry          DateTime?
  address                 String?
  city                    String?          @db.VarChar(100)
  state                   String?          @db.VarChar(100)
  zipCode                 String?          @db.VarChar(20)
  emergencyContactName    String?          @db.VarChar(200)
  emergencyContactPhone   String?          @db.VarChar(20)
  hasEnglishTest          Boolean          @default(false)
  englishTestType         EnglishTestType? @default(none)
  englishTestScore        String?          @db.VarChar(50)
  englishTestDate         DateTime?
  createdBy               Int?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @default(now())
  maritalStatus           String?          @db.VarChar(20)
  marriageCertificatePath String?          @db.VarChar(500)
  givenEmail              String?          @db.VarChar(255)
  applications            Application[]
  createdByUser           User?            @relation("StudentCreatedBy", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([email])
}

model AcademicQualification {
  id              Int         @id @default(autoincrement())
  applicationId   Int
  name            String      @db.VarChar(255)
  educationLevel  String      @db.VarChar(100)
  institutionName String      @db.VarChar(255)
  programName     String?     @db.VarChar(255)
  startDate       DateTime?
  endDate         DateTime?
  grade           String?     @db.VarChar(50)
  gpa             Float?
  isCompleted     Boolean     @default(true)
  documentPath    String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ApplicationStatus {
  id           Int           @id @default(autoincrement())
  status       String        @unique @db.VarChar(50)
  description  String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model IntendedProgram {
  id            Int         @id @default(autoincrement())
  applicationId Int
  country       String      @db.VarChar(100)
  university    String      @db.VarChar(255)
  programme     String      @db.VarChar(255)
  priority      Int         @default(1)
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Enquiry {
  id                    Int           @id @default(autoincrement())
  firstName             String        @db.VarChar(100)
  lastName              String?       @db.VarChar(100)
  email                 String?       @db.VarChar(255)
  phone                 String        @db.VarChar(20)
  cvDocument            String?       @db.VarChar(500)
  firstFollowUpRemarks  String?
  secondFollowUpRemarks String?
  thirdFollowUpRemarks  String?
  remarks               String?
  createdBy             String?       @db.VarChar(255)
  assignedToId          Int?
  countryId             Int?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  applications          Application[] @relation("ApplicationFromEnquiry")
  assignedTo            User?         @relation("EnquiryAssignedTo", fields: [assignedToId], references: [id])
  country               Country?      @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@index([assignedToId])
  @@index([countryId])
  @@index([email])
  @@index([createdAt])
}

model Application {
  id                     Int                        @id @default(autoincrement())
  applicationRef         String                     @unique @db.VarChar(100)
  enquiryId              Int?
  firstName              String                     @db.VarChar(100)
  lastName               String                     @db.VarChar(100)
  universityId           Int
  intendedProgram        String                     @db.VarChar(255)
  intakeYear             Int
  intakeMonth            String                     @db.VarChar(20)
  applicationStatusId    Int?
  assignedAgentId        Int?
  applicationFee         Float                      @default(0)
  feePaid                Boolean                    @default(false)
  registered             Boolean                    @default(false)
  countryId              Int?
  submissionDate         DateTime?
  decisionDate           DateTime?
  notes                  String?
  remarks                String?
  createdBy              String?                    @db.VarChar(255)
  assignedToId           Int?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  studentId              Int?
  academicQualifications AcademicQualification[]
  applicationStatus      ApplicationStatus?         @relation(fields: [applicationStatusId], references: [id])
  assignedAgent          User?                      @relation("ApplicationAssignedAgent", fields: [assignedAgentId], references: [id])
  assignedTo             User?                      @relation("ApplicationAssignedTo", fields: [assignedToId], references: [id])
  country                Country?                   @relation(fields: [countryId], references: [id])
  enquiry                Enquiry?                   @relation("ApplicationFromEnquiry", fields: [enquiryId], references: [id])
  student                Student?                   @relation(fields: [studentId], references: [id])
  university             University                 @relation(fields: [universityId], references: [id])
  communications         ApplicationCommunication[]
  documents              ApplicationDocument[]
  intendedPrograms       IntendedProgram[]

  @@index([enquiryId])
  @@index([universityId])
  @@index([applicationStatusId])
  @@index([assignedAgentId])
  @@index([assignedToId])
  @@index([countryId])
  @@index([createdAt])
}

model ApplicationDocument {
  id             Int         @id @default(autoincrement())
  applicationId  Int
  documentType   String      @db.VarChar(100)
  fileName       String      @db.VarChar(255)
  filePath       String      @db.VarChar(500)
  fileSize       Int?
  uploadedBy     Int?
  uploadedAt     DateTime    @default(now())
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedByUser User?       @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id])

  @@index([applicationId])
}

model ApplicationCommunication {
  id                Int               @id @default(autoincrement())
  applicationId     Int
  userId            Int?
  communicationType CommunicationType
  subject           String?           @db.VarChar(255)
  message           String
  nextFollowUp      DateTime?
  createdAt         DateTime          @default(now())
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id])

  @@index([applicationId])
  @@index([userId])
}

enum Gender {
  male
  female
  other
}

enum EnglishTestType {
  ielts
  toefl
  pte
  duolingo
  none
}

enum CommunicationType {
  email
  call
  meeting
  note
}
